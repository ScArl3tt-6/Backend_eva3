# ============================================================
# .env.example — PLANTILLA DE VARIABLES DE ENTORNO
# Copie este archivo a ".env" (nunca se sube al repositorio) y
# complete los valores reales de su máquina o del servidor.
#
# ADVERTENCIA SOBRE python-decouple: una variable que está
# PRESENTE pero VACÍA (p. ej. "DEBUG=") NO cae en el valor por
# omisión del código: decouple la lee como cadena vacía "" y la
# castea tal cual (bool("") -> False, pero Csv()("") -> ['']).
# Si quiere que una variable use su valor por omisión, elimínela
# por completo del .env en vez de dejarla vacía.
#
# Este archivo trae los valores para DESARROLLO LOCAL. Los valores
# de PRODUCCIÓN (servidor EC2) están comentados más abajo, en el
# bloque "SOLO PARA EL SERVIDOR DE PRODUCCIÓN": cópielos aparte,
# nunca junto a los de desarrollo.
# ============================================================

# --- Identificación de la alumna y nombre comercial ---
ALUMNO_NOMBRE=Genesis Quezada Sanzana
NOMBRE_COMERCIAL=FitLife

# --- Seguridad y entorno ---
# SECRET_KEY es obligatoria (no tiene valor por omisión): genere una propia con
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# NUNCA reutilice la misma SECRET_KEY entre su máquina y el servidor.
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver

# --- HTTPS detrás de un proxy (Nginx + Let's Encrypt) ---
# En local se deja en False. En el servidor EC2, con Nginx mandando
# X-Forwarded-Proto (vía "include proxy_params"), se activa en True.
DETRAS_DE_PROXY_HTTPS=False
CSRF_TRUSTED_ORIGINS=

# --- Base de datos PostgreSQL (motor obligatorio del proyecto) ---
# El usuario debe tener LOGIN y CREATEDB (CREATEDB es necesario para que
# "manage.py test" pueda crear y destruir la base de pruebas).
#
# DB_PORT: use el puerto donde realmente escucha SU PostgreSQL, no un
# valor fijo. Si tiene más de una instalación instalada (por ejemplo,
# PostgreSQL 16 y PostgreSQL 18 al mismo tiempo en Windows), cada una
# escucha en un puerto distinto (5432, 5433, ...); verifíquelo con
# Get-Service *postgresql* y netstat, o pregunte a quien administra el
# servidor. En el servidor de AWS esto lo define quien instaló
# PostgreSQL; use SIEMPRE un usuario y una contraseña propios del
# servidor, nunca los de este archivo de ejemplo ni los de un entorno
# de desarrollo local.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=fitlife_db
DB_USER=fitlife_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Sesión del sitio web (en segundos; 1209600 = 14 días) ---
SESSION_COOKIE_AGE=1209600

# --- Reglas de negocio configurables ---
# Días mínimos y máximos que un socio puede congelar su membresía.
CONGELAMIENTO_DIAS_MIN=7
CONGELAMIENTO_DIAS_MAX=60
# Minutos de anticipación mínima para cancelar una reserva de clase.
CANCELACION_MINUTOS_LIMITE=60

# Nota: el aforo máximo del gimnasio NO se configura aquí. Vive en la
# base de datos (modelo accesos.Instalacion, editable desde el Django
# Admin) para poder bloquear esa fila con select_for_update() durante
# la validación de accesos y evitar condiciones de carrera.


# ============================================================
# SOLO PARA EL SERVIDOR DE PRODUCCIÓN (EC2) — NO USAR EN LOCAL
# Copie estas líneas al .env del servidor, reemplazando las de
# arriba. DB_USER/DB_PASSWORD deben ser los del PostgreSQL del
# servidor, nunca los de este archivo ni los de su máquina.
# ============================================================
# SECRET_KEY=<genere una distinta de la de desarrollo>
# DEBUG=False
# ALLOWED_HOSTS=hardpoint-genesis.duckdns.org,100.62.227.34,localhost,127.0.0.1
# DETRAS_DE_PROXY_HTTPS=True
# CSRF_TRUSTED_ORIGINS=https://hardpoint-genesis.duckdns.org
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=fitlife_db
# DB_USER=<usuario de PostgreSQL del servidor>
# DB_PASSWORD=<contraseña del servidor>
# DB_HOST=localhost
# DB_PORT=5432
# SESSION_COOKIE_AGE=1209600
# CONGELAMIENTO_DIAS_MIN=7
# CONGELAMIENTO_DIAS_MAX=60
# CANCELACION_MINUTOS_LIMITE=60
